    "create:mixing": {
      "_comment": "Woodencog makes a basin on a TFC charcoal forge a Create heat source: 750 °C and up is 'heated' (any forge fuel), 2000 °C 'superheated' (a forge with bellows).",
      "param": "heat_requirement",
      "tiers": {
        "none": [],
        "heated": [
          "create:blaze_burner",
          "world:heat/charcoal_forge/*"
        ],
        "superheated": [
          "create:blaze_burner",
          "world:heat/charcoal_forge/bellows"
        ]
      },
      "default": "none",
      "also": [
        "create:mechanical_mixer",
