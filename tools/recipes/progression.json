  "gregtech": {
    "_comment": "gtceu:* recipe types need a machine named after the type: gtceu:<tier>_<type> at or above the recipe's voltage, a steam variant (gtceu:lp_steam_<type>/hp_steam_<type>) for recipes up to LV (GregTech's steam machines run any LV-tier recipe; low pressure takes twice as long), or a multiblock controller gtceu:<type>. EBF recipes also need a coil at or above ebf_temp.",
    "steam_max_eut": {
      "lp": 32,
      "hp": 32
    },
    "coils": {
      "cupronickel": 1800,
      "kanthal": 2700,
      "nichrome": 3600,
      "rtm_alloy": 4500,
      "hssg": 5400,
      "naquadah": 7200,
      "trinium": 9001,
      "tritanium": 10800
    },
    "machine_aliases": {
      "gtceu:chemical_reactor": [
        "gtceu:large_chemical_reactor"
      ],
      "gtceu:steam_boiler": [
        "gtceu:lp_steam_liquid_boiler",
        "gtceu:hp_steam_liquid_boiler"
      ],
      "gtceu:large_boiler": [
        "gtceu:bronze_large_boiler",
        "gtceu:steel_large_boiler",
        "gtceu:titanium_large_boiler",
        "gtceu:tungstensteel_large_boiler"
      ],
      "gtceu:combustion_generator": [
        "gtceu:combustion",
        "gtceu:large_combustion_engine",
        "gtceu:extreme_combustion_engine"
      ],
      "gtceu:gas_turbine": [
        "gtceu:gas_large_turbine"
      ],
      "gtceu:steam_turbine": [
        "gtceu:steam_large_turbine"
      ],
      "gtceu:plasma_generator": [
        "gtceu:plasma_large_turbine"
      ],
      "gtceu:rock_breaker": [
        "gtceu:rock_crusher"
      ]
    },
    "power": {
      "_comment": "A GregTech machine (also as a station elsewhere, e.g. smelting) counts only with power: steam machines and steam multiblocks need 'steam', electric machines and electric multiblocks need 'electric'. Fuel recipe types produce power nodes; their own machines need none, nor do 'unpowered' ones.",
      "steam": "world:power/steam",
      "electric": "world:power/electric",
      "unpowered": [
        "gtceu:coke_oven",
        "gtceu:primitive_blast_furnace",
        "gtceu:primitive_pump"
      ],
      "steam_multiblocks": [
        "gtceu:steam_grinder",
        "gtceu:steam_oven"
      ],
      "fuel_recipes": {
        "gtceu:steam_boiler": [
          "world:power/steam",
          "f:gtceu:steam"
        ],
        "gtceu:large_boiler": [
          "world:power/steam",
          "f:gtceu:steam"
        ],
        "gtceu:steam_turbine": [
          "world:power/electric"
        ],
        "gtceu:combustion_generator": [
          "world:power/electric"
        ],
        "gtceu:gas_turbine": [
          "world:power/electric"
        ],
        "gtceu:plasma_generator": [
          "world:power/electric"
        ]
      }
    }
  },
  "rules": [
    {
      "item": "i:create:andesite_alloy",
      "requires": [
        "#i:c:nuggets/zinc",
        "#i:c:nuggets/bronze",
        "#i:c:nuggets/wrought_iron"
      ],
      "why": "design: andesite alloy needs metal nuggets (zinc or bronze in the bronze age, iron later), not just stone"
    },
    {
      "item": "i:create:water_wheel",
      "requires": [
        "i:create:andesite_alloy"
      ],
      "why": "design: Create's kinetics start from andesite alloy"
    },
    {
      "item": "i:create:mechanical_press",
      "requires": [
        "#i:c:sheets/wrought_iron"
      ],
      "why": "design: heavy Create machines need TFC wrought iron sheets"
    },
    {
      "item": "i:create:mechanical_mixer",
      "requires": [
        "#i:c:sheets/wrought_iron"
      ],
      "why": "design: heavy Create machines need TFC wrought iron sheets"
    },
    {
      "item": "i:create:deployer",
      "requires": [
        "#i:c:sheets/wrought_iron"
      ],
      "why": "design: heavy Create machines need TFC wrought iron sheets"
    },
    {
      "item": "i:gtceu:lp_steam_solid_boiler",
      "requires": [
        "@create_parts"
      ],
      "why": "design: GregTech's first boiler needs a Create machine part"
    },
    {
      "item": "i:gtceu:lp_steam_solid_boiler",
      "requires": [
        "i:tfc:fire_bricks",
        "i:tfc:ceramic/fire_brick"
      ],
      "why": "design: GregTech's first boiler uses TFC fire bricks instead of a vanilla furnace"
    },
    {
      "item": "i:gtceu:hp_steam_solid_boiler",
      "requires": [
        "#i:c:ingots/steel"
      ],
      "why": "design: high-pressure steam needs TFC steel"
    },
    {
      "item": "i:gtceu:lv_machine_hull",
      "requires": [
        "#i:c:ingots/steel"
      ],
      "why": "design: LV electrics need TFC steel"
    },
    {
      "item": "#i:c:ingots/steel",
      "requires": [
        "i:tfc:metal/ingot/pig_iron"
      ],
      "why": "design: steel comes from TFC's blast furnace route (pig iron), not from a shortcut"
    },
    {
      "item": "#i:c:ingots/wrought_iron",
      "requires": [
        "i:tfc:bloomery"
      ],
      "why": "design: wrought iron comes from TFC's bloomery; GregTech's ore smelting gives cast iron"
    },
    {
      "item": "i:aeronautics:propeller_bearing",
      "requires": [
        "#i:c:ingots/brass"
      ],
      "why": "design: airships unlock with brass"
    },
    {
      "item": "i:gtceu:lp_steam_liquid_boiler",
      "requires": [
        "@create_parts"
      ],
      "why": "design: every GregTech boiler needs a Create part, so the steam age can't skip Create"
    },
    {
      "item": "i:gtceu:lp_steam_solar_boiler",
      "requires": [
        "@create_parts"
      ],
      "why": "design: every GregTech boiler needs a Create part, so the steam age can't skip Create"
    },
    {
      "item": "i:gtceu:hp_steam_solid_boiler",
      "requires": [
        "@create_parts"
      ],
      "why": "design: every GregTech boiler needs a Create part, so the steam age can't skip Create"
