  "actions": [
    {
      "id": "build_firepit",
      "inputs": [
        [
          "#i:tfc:firepit_sticks"
        ],
        [
          "#i:tfc:firepit_logs"
        ],
        [
          "tfc:firestarter"
        ]
      ],
      "outputs": [
        "tfc:firepit"
      ],
      "why": "field guide: throw one log and three sticks on the ground and use a firestarter on them"
    },
    {
      "id": "pit_kiln",
      "inputs": [
        [
          "#i:tfc:pit_kiln_straw"
        ],
        [
          "#i:tfc:pit_kiln_logs"
        ],
        [
          "tfc:firestarter",
          "tfc:torch"
        ]
      ],
      "outputs": [
        "world:pit_kiln"
      ],
      "why": "place unfired pottery, cover it with straw and logs, and light it"
    },
    {
      "id": "charcoal_pit",
      "inputs": [
        [
          "#i:tfc:log_pile_logs"
        ],
        [
          "tfc:firestarter",
          "tfc:torch"
        ]
      ],
      "outputs": [
        "minecraft:charcoal"
      ],
      "why": "a covered, lit log pile burns down into charcoal"
    },
    {
      "id": "charcoal_forge",
      "inputs": [
        [
          "minecraft:charcoal"
        ],
        [
          "tfc:firestarter",
          "tfc:torch"
        ],
        [
          "#i:c:stones",
          "tfc:rock/raw/*",
          "tfc:rock/cobble/*",
          "tfc:rock/bricks/*"
        ]
      ],
      "outputs": [
        "world:charcoal_forge"
      ],
      "why": "field guide: a charcoal pile of 7-8 layers surrounded by 5 stone blocks, then lit"
    },
    {
      "id": "stone_anvil",
      "inputs": [
        [
          "tfc:rock/raw/*"
        ],
        [
          "tfc:stone/hammer/*",
          "#i:c:tools/hammer"
        ]
      ],
      "outputs": [
        "tfc:rock/anvil/*"
      ],
      "why": "use a hammer on a raw igneous rock block"
    },
    {
      "id": "strip_log",
      "inputs": [
        [
          "tfc:wood/log/*",
          "tfc:wood/wood/*"
        ],
        [
          "#i:minecraft:axes",
          "tfc:stone/axe/*",
          "tfc:metal/axe/*"
        ]
      ],
      "outputs": [
        "tfc:wood/stripped_log/*",
        "tfc:wood/stripped_wood/*"
      ],
      "why": "use an axe on a placed TFC log or wood block"
    },
    {
      "id": "strip_log_afc",
      "inputs": [
        [
          "afc:wood/log/*",
          "afc:wood/wood/*"
        ],
        [
          "#i:minecraft:axes",
          "tfc:stone/axe/*",
          "tfc:metal/axe/*"
        ]
      ],
      "outputs": [
        "afc:wood/stripped_log/*",
        "afc:wood/stripped_wood/*"
      ],
      "why": "use an axe on a placed ArborFirmaCraft log or wood block"
    },
    {
      "id": "boil_water",
      "inputs": [
        [
          "gtceu:*_steam_solid_boiler",
          "gtceu:*_steam_solar_boiler"
        ]
      ],
      "outputs": [
        "world:power/steam",
        "f:gtceu:steam"
      ],
      "why": "a GregTech solid boiler burning logs or charcoal, or a solar boiler in the sun, makes steam"
    },
    {
      "id": "entroize_fluix",
      "inputs": [
        [
          "extendedae:entro_seed"
        ],
        [
          "ae2:fluix_block"
        ]
      ],
      "outputs": [
        "extendedae:entro_budding_mostly"
      ],
      "why": "ExtendedAE's guide: right-click a fluix block with an entro seed to make entroized fluix budding (its crystal assembler makes a lower grade)"
    },
    {
      "id": "grow_entro",
      "inputs": [
        [
          "extendedae:entro_budding_*"
        ]
      ],
      "outputs": [
        "extendedae:entro_shard",
        "extendedae:entro_dust"
      ],
      "why": "entroized budding grows entro clusters on its faces (like AE2's certus budding); a large cluster drops shards, the budding block itself dust"
    },
    {
      "id": "mine_vent_chimney",
      "inputs": [
        [
          "create:copper_diving_helmet",
          "create:netherite_diving_helmet"
        ],
        [
          "create:copper_diving_boots",
          "create:netherite_diving_boots"
        ],
        [
          "create:copper_backtank",
          "create:netherite_backtank"
        ],
        [
          "#i:minecraft:pickaxes",
          "tfc:metal/pickaxe/*"
        ]
      ],
      "outputs": [
        "gtceu:raw_chalcopyrite",
        "gtceu:raw_pyrite",
        "gtceu:raw_sphalerite",
        "gtceu:raw_galena"
      ],
      "why": "dive to a sulfide chimney on the mid-ocean ridge's axis (pack:sulfide_chimney, pack:sulfide_mound) and mine it with a pickaxe; copper diving gear and a backtank are enough"
    },
    {
      "id": "mine_anhydrite_chimney",
      "inputs": [
        [
          "create:copper_diving_helmet",
          "create:netherite_diving_helmet"
        ],
        [
          "create:copper_diving_boots",
          "create:netherite_diving_boots"
        ],
        [
          "create:copper_backtank",
          "create:netherite_backtank"
        ],
        [
          "#i:minecraft:pickaxes",
          "tfc:metal/pickaxe/*"
        ]
      ],
      "outputs": [
        "gtceu:raw_gypsum",
        "gtceu:raw_sphalerite",
        "gtceu:raw_pollucite"
      ],
      "why": "dive to an anhydrite chimney on the volcanic arc (pack:anhydrite_chimney) and mine it with a pickaxe"
    },
    {
      "id": "sweep_nodule_bed",
      "inputs": [
        [
          "create:copper_diving_helmet",
          "create:netherite_diving_helmet"
        ],
        [
          "create:copper_diving_boots",
          "create:netherite_diving_boots"
        ],
        [
          "create:copper_backtank",
          "create:netherite_backtank"
        ],
        [
          "#i:minecraft:shovels",
          "tfc:metal/shovel/*"
        ]
      ],
      "outputs": [
        "gtceu:raw_pyrolusite",
        "gtceu:raw_cobaltite"
      ],
      "why": "dive to the deep ocean floor and dig a manganese nodule bed (pack:nodule_bed) with a shovel"
    },
    {
      "id": "pick_loose_nodule",
      "inputs": [
        [
          "create:copper_diving_helmet",
          "create:netherite_diving_helmet"
        ],
        [
          "create:copper_diving_boots",
          "create:netherite_diving_boots"
        ],
        [
          "create:copper_backtank",
          "create:netherite_backtank"
        ]
      ],
      "outputs": [
        "gtceu:raw_pyrolusite",
        "gtceu:raw_cobaltite"
      ],
      "why": "dive to the deep ocean floor and pick a loose manganese nodule (pack:nodule) up by hand, no tool"
    },
    {
      "id": "mine_mn_crust",
      "inputs": [
        [
          "create:copper_diving_helmet",
          "create:netherite_diving_helmet"
        ],
        [
          "create:copper_diving_boots",
          "create:netherite_diving_boots"
        ],
        [
          "create:copper_backtank",
          "create:netherite_backtank"
        ],
        [
          "#i:minecraft:pickaxes",
          "tfc:metal/pickaxe/*"
        ]
      ],
      "outputs": [
        "gtceu:raw_pyrolusite",
        "gtceu:raw_cobaltite",
        "gtceu:raw_pitchblende"
      ],
      "why": "dive to bare ridge or arc rock and mine its manganese crust (pack:mn_crust) with a pickaxe"
    },
    {
      "id": "break_bee_nest",
      "inputs": [
        [
          "complicated_bees:bee_nest"
        ]
      ],
      "outputs": [
        "complicated_bees:princess",
        "complicated_bees:drone",
        "complicated_bees:comb"
      ],
      "why": "breaking a wild nest (the pack's crafted ones too) without silk touch drops a princess, drones and combs (its loot table)"
    },
    {
      "id": "keep_bees",
      "inputs": [
        [
          "complicated_bees:apiary"
        ],
        [
          "complicated_bees:princess"
        ],
        [
          "complicated_bees:drone"
        ]
      ],
      "outputs": [
        "complicated_bees:queen",
        "complicated_bees:comb",
        "complicated_bees:propolis",
        "complicated_bees:pollen"
      ],
      "why": "a princess and a drone in an apiary make a queen, which produces combs and propolis in time (genetics and the other products aren't modelled)"
    }
  ],
  "heat": {
    "_comment": "Heating recipes need a device hot enough for the recipe. A device's ceiling is the hottest fuel it can burn (TFC fuel data, read from the jars). A bellows lifts the charcoal forge's ceiling; the boost isn't modeled, so forge + bellows counts as any temperature. The pit kiln reaches tfc-server.toml's pitKilnTemperature and only fires unfired pottery. Woodencog's heated basin recipes (temperature in heat_requirement) take their heat from a charcoal forge under the basin; its heated pressing works on items heated in a forge.",
    "temperature_params": [
      "temperature",
      "heat_requirement"
    ],
    "devices": [
      {
        "id": "firepit",
        "node": "tfc:firepit",
        "fuel": "#i:tfc:firepit_fuel",
        "types": [
          "tfc:heating",
          "tfc:pot"
        ]
      },
      {
        "id": "charcoal_forge",
        "node": "world:charcoal_forge",
        "fuel": "#i:tfc:forge_fuel",
        "bellows": "tfc:bellows",
        "types": [
          "tfc:heating",
          "woodencog:heated_mixing",
          "woodencog:heated_compacting",
          "woodencog:heated_pressing"
        ]
      }
    ],
    "pit_kiln": {
      "node": "world:pit_kiln",
      "only": "#i:tfc:unfired_pottery"
    }
  },
