{
  "_comment": [
    "Progression checker config. Patterns: 'i:ns:path' (item), 'f:ns:path' (fluid), '#i:tag', '#f:tag'; '*' and '?' globs work.",
    "A bare 'ns:path' means an item. stations: per recipe type, a list of requirements that must ALL be available;",
    "a requirement that is itself a list means any one of those. Tiered stations pick every tier at or above the recipe's value.",
    "Station rules and starter rules below are a first pass; tune them to the progression you design."
  ],
  "seeds": {
    "_comment": "Starting resources: blocks found in the scanned world (their loot-table drops) plus fluids in it, plus extras. Mob drops aren't in block loot tables, so common animal and mob drops are listed here. ArborFirmaCraft's trees (globs, expanded to every matching item) grow in forests but the scanned test world may predate the mod, so they are listed too.",
    "from_world": true,
    "extra": [
      "tfc:small_raw_hide",
      "tfc:medium_raw_hide",
      "tfc:large_raw_hide",
      "minecraft:bone",
      "minecraft:feather",
      "minecraft:string",
      "minecraft:egg",
      "minecraft:rotten_flesh",
      "minecraft:gunpowder",
      "minecraft:spider_eye",
      "afc:wood/log/*",
      "afc:wood/leaves/*",
      "afc:wood/fallen_leaves/*",
      "afc:wood/sapling/*",
      "afc:wood/twig/*"
    ],
    "exclude": [
      "minecraft:bedrock"
    ]
  },
