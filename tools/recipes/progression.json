    {
      "item": "i:afc:tree_tap",
      "requires": [
        "#i:c:sheets/wrought_iron"
      ],
      "why": "design: ArborFirmaCraft's tree tap is a wrought iron sheet, so sap, syrup, sugar and latex are iron-age and AFC gives no early glue or sugar"
    },
    {
      "item": "i:framedblocks:framing_saw",
      "requires": [
        "#i:c:ingots/wrought_iron"
      ],
      "why": "design: Framed Blocks' saw takes an iron ingot, which is TFC wrought iron here, so framed blocks are iron-age"
    },
    {
      "item": "i:rnr:metal/mattock/wrought_iron",
      "requires": [
        "#i:c:ingots/wrought_iron"
      ],
      "why": "design: Roads and Roofs mattocks follow TFC's tool tiers (wrought iron mattock needs wrought iron)"
