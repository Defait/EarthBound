  "gregtech": {
    "_comment": "gtceu:* recipe types need a machine named after the type: gtceu:<tier>_<type> at or above the recipe's voltage, a steam variant (gtceu:lp_steam_<type>/hp_steam_<type>) for recipes up to LV (GregTech's steam machines run any LV-tier recipe; low pressure takes twice as long), or a multiblock controller gtceu:<type>. EBF recipes also need a coil at or above ebf_temp.",
    "steam_max_eut": {
      "lp": 32,
      "hp": 32
    },
    "coils": {
