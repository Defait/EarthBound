    {
      "item": "@airship_thrust",
      "requires": [
        "@brass"
      ],
      "why": "design: airships unlock with brass: thrust (every propeller)"
    },
    {
      "item": "aeronautics:*_envelope",
      "requires": [
        "@brass"
      ],
      "why": "design: airships unlock with brass: envelopes"
    },
    {
      "item": "simulated:red_portable_engine",
      "requires": [
        "@brass"
      ],
      "why": "design: airships unlock with brass: portable engines"
