# Exported packs (packwiz modrinth export / curseforge export)
*.mrpack
/*.zip

# Local packwiz binaries / installer
packwiz.exe
packwiz-installer*.jar

# OS / editor junk
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/

# ProbeJS-generated editor files (regenerated per instance with /probejs dump)
kubejs/**/jsconfig.json
kubejs/package.json
kubejs/config/probe-settings.json
kubejs/export/

# Dev tooling environment and caches
tools/.venv/
tools/**/.cache/
__pycache__/

# Dev tool state: test server, reports, dumps
tools/.server/
tools/.data/

# The pack's own mod (mod/): Gradle and ModDevGradle build outputs and caches
mod/build/
mod/.gradle/
mod/run/
mod/runs/
mod/out/
mod/bin/
mod/.idea/
mod/*.iml
